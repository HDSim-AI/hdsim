# Copy this file to .env and fill in a key. Nothing else is required.
#
#   cp .env.example .env
#
# Any provider that speaks the OpenAI chat API works. Set the base URL to point at it.
# Exported environment variables take precedence over this file.

HDSIM_API_KEY=
HDSIM_MODEL=gpt-4o-mini
HDSIM_BASE_URL=https://api.openai.com/v1

# Examples of other endpoints:
#   Ollama       HDSIM_BASE_URL=http://localhost:11434/v1     (key can stay empty)
#   vLLM         HDSIM_BASE_URL=http://localhost:8000/v1
#   Together     HDSIM_BASE_URL=https://api.together.xyz/v1
#   OpenRouter   HDSIM_BASE_URL=https://openrouter.ai/api/v1

# Optional. A member proposing a number is a cheap call; the whole-household consensus call is the
# one worth a stronger model. Anything left blank falls back to HDSIM_MODEL.
HDSIM_PERSONA_MODEL=
HDSIM_MEMBER_MODEL=
HDSIM_MODERATOR_MODEL=
